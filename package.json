{
  "name": "@kxh4892636/music",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"pnpm run dev:server\" \"pnpm run dev:web\"",
    "dev:server": "node --watch --experimental-strip-types server/main.ts",
    "dev:web": "vp dev",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.server.json && vp build",
    "start": "node dist/server/main.js",
    "test": "vp test run",
    "test:e2e": "pnpm build && playwright test",
    "data": "python scripts/build-library.py"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.100.8",
    "@tanstack/react-router": "^1.169.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "4.13.7",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwind-merge": "^3.6.0",
    "zod": "4.5.4",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@~7.0.2",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.2.4",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.22.0"
}
